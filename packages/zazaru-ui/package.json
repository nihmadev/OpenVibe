{
  "name": "@zazaru/ui",
  "version": "0.1.0",
  "description": "Accessible, themeable React components for dense application interfaces.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "README.md", "MIGRATION.md", "LICENSE"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./themes/dark.css": "./dist/themes/dark.css",
    "./themes/light.css": "./dist/themes/light.css",
    "./themes/high-contrast.css": "./dist/themes/high-contrast.css",
    "./recipes": { "types": "./dist/recipes/index.d.ts", "import": "./dist/recipes/index.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:js": "tsup src/index.ts src/recipes/index.ts --format esm --dts --sourcemap --external react --external react-dom",
    "build:css": "esbuild src/styles.css --bundle --outfile=dist/styles.css && mkdir -p dist/themes && cp src/tokens.css dist/tokens.css && cp src/themes/*.css dist/themes/",
    "build": "npm run clean && npm run build:js && npm run build:css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:a11y": "vitest run src/__tests__/accessibility.test.tsx",
    "test:visual": "playwright test",
    "test:package": "npm run build && npm pack --dry-run",
    "showcase": "ladle serve --host 127.0.0.1 --port 6111",
    "showcase:build": "ladle build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": { "react": ">=18.2.0", "react-dom": ">=18.2.0" },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@ladle/react": "^5.0.3",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "axe-core": "^4.10.3",
    "esbuild": "^0.25.9",
    "fast-check": "^4.3.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": { "node": ">=18" },
  "repository": { "type": "git", "url": "git+https://github.com/nihmadev/OpenVibe.git", "directory": "packages/zazaru-ui" },
  "homepage": "https://github.com/nihmadev/OpenVibe/tree/main/packages/zazaru-ui",
  "bugs": "https://github.com/nihmadev/OpenVibe/issues",
  "keywords": ["react", "components", "accessibility", "design-system", "ui"]
}
